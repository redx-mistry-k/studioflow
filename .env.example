# ============================================================
# StudioFlow — environment template
# Copy to .env and fill in:  cp .env.example .env
# ============================================================

# ---------- Database ----------
# Docker / production (PostgreSQL):
DATABASE_URL=postgresql://studioflow:studioflow_secret@postgres:5432/studioflow?schema=public
# Local dev fallback (SQLite file, no external DB needed):
# DATABASE_URL=file:./dev.db

# ---------- Backend ----------
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
# Set to "true" when serving the app over HTTPS (marks the auth cookie Secure)
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Seed demo data on first boot (docker entrypoint)
SEED_DEMO=true

# ---------- Frontend ----------
# In Docker the frontend is served by nginx which proxies /api to backend.
# For local dev (vite), the dev server proxies /api to localhost:4000.
VITE_API_URL=

# ---------- SMTP / Email (optional — runs in MOCK mode if empty) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=hello@studioflow.local
SMTP_FROM_NAME=StudioFlow

# ---------- WhatsApp Cloud API (optional — MOCK mode if empty) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=studioflow_verify_token
WHATSAPP_APP_SECRET=

# ---------- Instagram Messaging API (optional — MOCK mode if empty) ----------
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=studioflow_verify_token
INSTAGRAM_APP_SECRET=

# ---------- n8n (optional) ----------
# Outgoing: StudioFlow POSTs automation events here if set.
N8N_WEBHOOK_URL=
# Incoming: n8n can call StudioFlow APIs using an API key (same as JWT for MVP).
